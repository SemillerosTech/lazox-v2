# Número oficial de WhatsApp con código de país, sin "+" ni espacios.
# Si está vacío, la tienda muestra el panel de demostración.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL pública del sitio. Se usa para el sitemap y metadatos canónicos.
NEXT_PUBLIC_SITE_URL=

# Recorrido guiado de demostración. Debe ser "true" para mostrar el botón.
# Sin esta variable o con cualquier otro valor, el recorrido no se carga.
NEXT_PUBLIC_ENABLE_DEMO_TOUR=false

# Dos precios. Se enciende solo cuando abogado y contador cierren la cuenta del 30 %.
NEXT_PUBLIC_ENABLE_DUAL_PRICING=false

# URL del sistema de facturación de Shopify. Mientras no exista, /factura.
NEXT_PUBLIC_SHOPIFY_INVOICE_URL=

# ── Fuente de catálogo ────────────────────────────────────────────────────────
# "local-draft" (borrador en lib/data) o "shopify". Sin fallback silencioso.
LAZOX_CATALOG_SOURCE=local-draft

# ── Shopify Storefront API (solo servidor) ────────────────────────────────────
# Hostname canónico, por ejemplo: mi-tienda.myshopify.com
# No use el identificador del administrador ni el dominio comercial.
SHOPIFY_STORE_DOMAIN=

# Token privado de Storefront API. NUNCA debe llevar el prefijo NEXT_PUBLIC_.
# Vive solo en el servidor y no se versiona.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Versión de la API en formato YYYY-MM.
SHOPIFY_STOREFRONT_API_VERSION=2026-10

# ── Interruptores de servidor ─────────────────────────────────────────────────
# El carrito y el checkout de Shopify permanecen cerrados hasta decisión explícita.
LAZOX_ENABLE_CART=false
LAZOX_ENABLE_CHECKOUT=false

# Reenvía la IP del comprador a Shopify solo si el proxy es de confianza.
LAZOX_TRUST_PROXY=false

# El borrador local no puede desplegarse salvo que se autorice explícitamente.
# Déjelo vacío en producción; use "true" solo mientras la tienda siga cerrada.
LAZOX_ALLOW_LOCAL_DRAFT_ON_VERCEL=
