# Acceso privado a la guía (obligatorio en producción).
# En la demo puede quedar vacío si GUIDE_PUBLIC_DEMO=true.
GUIDE_ACCESS_PASSWORD=cambie-esta-clave

# Excepción temporal de la demo: abre /guias sin contraseña.
# Nunca active esta variable en producción.
GUIDE_PUBLIC_DEMO=false

# Número oficial de WhatsApp con código de país, sin "+" ni espacios.
# Si está vacío, la ficha muestra la demostración.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL pública del sitio. Se usa para el sitemap y metadatos canónicos.
NEXT_PUBLIC_SITE_URL=

# Recorrido guiado de demostración. Debe ser "true" para mostrar el botón.
# Sin esta variable o con cualquier otro valor, el recorrido no se carga.
NEXT_PUBLIC_ENABLE_DEMO_TOUR=false
