# Número oficial de WhatsApp con código de país, sin "+" ni espacios.
# Si está vacío, la tienda muestra el panel de demostración.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL pública del sitio. Se usa para el sitemap y metadatos canónicos.
NEXT_PUBLIC_SITE_URL=

# Recorrido guiado de demostración. Debe ser "true" para mostrar el botón.
# Sin esta variable o con cualquier otro valor, el recorrido no se carga.
NEXT_PUBLIC_ENABLE_DEMO_TOUR=false

# Dos precios. Se enciende solo cuando abogado y contador cierren la cuenta del 30 %.
NEXT_PUBLIC_ENABLE_DUAL_PRICING=false

# URL del sistema de facturación de Shopify. Mientras no exista, /factura.
NEXT_PUBLIC_SHOPIFY_INVOICE_URL=
