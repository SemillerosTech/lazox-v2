# Acceso privado a la guía (obligatorio en producción).
# Sin esta variable, /guias queda bloqueada.
GUIDE_ACCESS_PASSWORD=cambie-esta-clave

# Número oficial de WhatsApp con código de país, sin "+" ni espacios.
# Si está vacío, la ficha muestra la demostración.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL pública del sitio. Se usa para el sitemap y metadatos canónicos.
NEXT_PUBLIC_SITE_URL=
